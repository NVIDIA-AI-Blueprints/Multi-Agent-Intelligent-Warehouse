#
# OpenShell sandbox policy for the MAIW v2 reference deployment
# (v2.0.1 round 2, NEW-P1-02 §21).  Rendered by
# scripts/setup/reference_sandbox.sh, which substitutes __MAIW_API_HOST_IP__ and
# __MAIW_API_PORT__ from MAIW_SANDBOX_MODEL_GATEWAY_ENDPOINT.
#
# Network: deny-by-default; the ONLY allowed egress is the canonical MAIW API
# (POST /api/v1/inference on the host).  No provider (integrate.api.nvidia.com),
# no internet, no metadata service, no host-private NIMs, no databases.
# Credentials: none — the sandbox holds only the internal inference token,
# passed on stdin by the operator, never a provider key.
version: 1
filesystem_policy:
  include_workdir: true
  read_only:
  - /usr
  - /lib
  - /proc
  - /dev/urandom
  - /app
  - /etc
  - /var/log
  read_write:
  - /sandbox
  - /tmp
  - /dev/null
landlock:
  compatibility: best_effort
network_policies:
  maiw_inference_only:
    name: maiw_inference_only
    endpoints:
    - host: '__MAIW_API_HOST_IP__'
      port: __MAIW_API_PORT__
      protocol: rest
      tls: passthrough
      enforcement: enforce
      access: full
    binaries:
    - path: /usr/bin/python3
    - path: /usr/local/bin/python3
