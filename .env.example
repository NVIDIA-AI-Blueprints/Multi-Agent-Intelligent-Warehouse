# =============================================================================
# Warehouse Operational Assistant - Environment Configuration
# =============================================================================
# 
# Copy this file to .env and update with your actual values:
#   cp .env.example .env
#   nano .env  # or your preferred editor
#
# For Docker Compose deployments, place .env in deploy/compose/ directory
# =============================================================================

# =============================================================================
# ENVIRONMENT
# =============================================================================
# Set to 'production' for production deployments, 'development' for local dev
ENVIRONMENT=development

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL/TimescaleDB)
# =============================================================================
# Database connection settings
POSTGRES_USER=warehouse
# ⚠️ CHANGE IN PRODUCTION!
POSTGRES_PASSWORD=changeme
POSTGRES_DB=warehouse
DB_HOST=localhost
DB_PORT=5435
# The app's SQL data path (and /api/v1/ready) connect with PGHOST / PGPORT /
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB.  If you also set
# DATABASE_URL it must name the SAME database (readiness and preflight fail
# otherwise).
PGHOST=127.0.0.1
PGPORT=5435
# Reference DB container managed by scripts/setup/reference_db.sh (up|status|down)
MAIW_DB_CONTAINER=maiw-reference-db

# Alternative database URL format (overrides individual settings above)
# DATABASE_URL=postgresql://warehouse:changeme@localhost:5435/warehouse

# =============================================================================
# SECURITY
# =============================================================================
# JWT Secret Key - REQUIRED for production, optional for development
# Generate a strong random key: openssl rand -hex 32
# Minimum 32 characters recommended
JWT_SECRET_KEY=your-strong-random-secret-minimum-32-characters-change-this-in-production

# Admin user default password (change in production!)
DEFAULT_ADMIN_PASSWORD=changeme

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty for development
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# VECTOR DATABASE (Milvus)
# =============================================================================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=root
MILVUS_PASSWORD=Milvus

# GPU Acceleration for Milvus
MILVUS_USE_GPU=true
MILVUS_GPU_DEVICE_ID=0
CUDA_VISIBLE_DEVICES=0
MILVUS_INDEX_TYPE=GPU_CAGRA
MILVUS_COLLECTION_NAME=warehouse_docs_gpu

# =============================================================================
# MESSAGE QUEUE (Kafka)
# =============================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Alternative: KAFKA_BROKER=kafka:9092

# =============================================================================
# NVIDIA NIM LLM CONFIGURATION
# =============================================================================
# Deployment modes:
#   nvidia_hosted (default) — NVIDIA public cloud; requires NVIDIA_API_KEY
#   local_nim               — Self-hosted NIM; set MAIW_NIM_BASE_URL + MAIW_NIM_MODEL
#   openai_compatible       — Any OpenAI-compatible endpoint
#   enterprise              — Enterprise NIM fleet
#
# For local NIM, use the setup script:
#   ./scripts/models/setup_local_nim.sh --url http://localhost:8000/v1 --model nvidia/nemotron-3-super-120b-a12b
# Then verify:
#   ./scripts/models/check_local_nim.sh

# --- NVIDIA HOSTED (default) -------------------------------------------------
NVIDIA_API_KEY=your-nvidia-api-key-here

# LLM Service Endpoint (NVIDIA public cloud)
LLM_NIM_URL=https://integrate.api.nvidia.com/v1

# LLM_MODEL is NOT used by ModelGateway dispatch (v2.0.1 round 2): the model a
# request is served by is the approved physical deployment bound to the routed
# role (see "MODEL ROLE BINDINGS" below).  If you set LLM_MODEL / MAIW_NIM_MODEL
# anyway, preflight requires it to name an approved model.
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- LOCAL NIM / CUSTOM ENDPOINT (uncomment to override hosted defaults) -----
# MAIW_MODEL_PROVIDER=local_nim
# MAIW_NIM_BASE_URL=http://localhost:8000/v1
# MAIW_NIM_API_KEY=                  # leave empty for local NIM without auth

# --- MODEL ROLE BINDINGS (v2.0.1 round 2) ------------------------------------
# ModelGateway routes a request to a logical role, then the DeploymentResolver
# binds that role to its APPROVED physical model ID (maiw_models/deployment.py,
# APPROVED_DEPLOYMENTS).  NEMOTRON_<ROLE>_MODEL may only select that approved ID;
# any other value (unknown ID, another role's ID, look-alike) makes the role
# fail closed: 503 MODEL_POLICY_VIOLATION, /api/v1/ready NOT_READY, preflight
# FAIL.  A provider that reports a different model than the one dispatched gets
# 502 MODEL_IDENTITY_MISMATCH.  Leave these unset to use the approved defaults:
#   NEMOTRON_LIGHTNING_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b   (nemotron-3.5, enabled)
#   NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b           (nemotron-3,   enabled)
#   NEMOTRON_ULTRA_MODEL=nvidia/nemotron-3-ultra-550b-a55b           (nemotron-3,   disabled; ~30s latency)
#   NEMOTRON_NANO_MODEL=nvidia/nemotron-3-nano-30b-a3b               (nemotron-3,   DISABLED)
#
# Nano is DISABLED by default: the hosted endpoint retired
# nvidia/nemotron-3-nano-30b-a3b on 2026-09-01 (HTTP 410).  MEDIUM-reasoning
# requests fall back to Super (route.fallback_used=true).  Enable Nano only with
# a working deployment of that exact ID (e.g. a self-hosted NIM):
# NEMOTRON_NANO_ENABLED=true

# LLM Generation Parameters
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_TOP_P=1.0
LLM_FREQUENCY_PENALTY=0.0
LLM_PRESENCE_PENALTY=0.0
# Timeout in seconds
LLM_CLIENT_TIMEOUT=120

# LLM Caching
LLM_CACHE_ENABLED=true
# Cache TTL in seconds (5 minutes)
LLM_CACHE_TTL_SECONDS=300

# =============================================================================
# EMBEDDING SERVICE CONFIGURATION
# =============================================================================
# Embedding service endpoint (always uses NVIDIA endpoint)
EMBEDDING_NIM_URL=https://integrate.api.nvidia.com/v1

# Embedding model (Nemotron 3 Embed 1B, 2048-dim).
# Replaces: nvidia/llama-nemotron-embed-vl-1b-v2 (deprecated per NVBug model deprecation campaign).
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_DIMENSION=2048

# Embedding API Key (defaults to NVIDIA_API_KEY if unset)
# Format: nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_API_KEY=your-nvidia-api-key-here

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Allowed origins for CORS (comma-separated)
# Add your frontend URLs here
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://127.0.0.1:3001,http://127.0.0.1:3000

# =============================================================================
# UPLOAD & REQUEST LIMITS
# =============================================================================
# Maximum request size in bytes (default: 10MB)
MAX_REQUEST_SIZE=10485760

# Maximum upload size in bytes (default: 50MB)
MAX_UPLOAD_SIZE=52428800

# =============================================================================
# NeMo Guardrails Configuration
# =============================================================================
# NeMo Guardrails API endpoint
RAIL_API_URL=https://integrate.api.nvidia.com/v1

# NeMo Guardrails API Key (defaults to NVIDIA_API_KEY if unset)
# Format: nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RAIL_API_KEY=your-nvidia-api-key-here

# =============================================================================
# Document Extraction Agent - NVIDIA NeMo API Keys
# =============================================================================
# All document processing NIMs use NVIDIA API keys (starts with "nvapi-")
# These can be the same as NVIDIA_API_KEY or EMBEDDING_API_KEY, or separate keys
# Format: nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEMO_RETRIEVER_API_KEY=your-nvidia-api-key-here
NEMO_OCR_API_KEY=your-nvidia-api-key-here
NEMO_PARSE_API_KEY=your-nvidia-api-key-here
# Multimodal VL processor key (Stage 3 document understanding)
NEMOTRON_OMNI_API_KEY=your-nvidia-api-key-here
# LLAMA_NANO_VL_API_KEY is a deprecated alias for NEMOTRON_OMNI_API_KEY — still accepted with a warning
# Large LLM Super key (Stage 5 judge / guardrails API path)
NEMOTRON_SUPER_API_KEY=your-nvidia-api-key-here
# LLAMA_49B_API_KEY is a deprecated alias for NEMOTRON_SUPER_API_KEY

# Large LLM Judge Timeout (seconds)
# Default: 120 seconds (2 minutes) — increase for complex documents
NEMOTRON_SUPER_TIMEOUT=120
# LLAMA_49B_TIMEOUT / LLAMA_70B_TIMEOUT are deprecated aliases for NEMOTRON_SUPER_TIMEOUT

# =============================================================================
# EXTERNAL SERVICE INTEGRATIONS
# =============================================================================
# WMS_API_KEY=your-wms-api-key
# ERP_API_KEY=your-erp-api-key

# =============================================================================
# DEMO MODE (backend)
# =============================================================================
# Set to 'true' to start the API in synthetic demo mode (uses SimulationProviders,
# no real database or MCP servers required). Used by scripts/start_demo_mode.sh.
# NEVER enable in production.
MAIW_DEMO_MODE=false

# =============================================================================
# FRONTEND ENVIRONMENT (src/ui/web/.env)
# =============================================================================
# These variables are consumed by the React frontend (Create React App convention).
# Copy this block into src/ui/web/.env to configure the frontend.
#
# API endpoint for the frontend proxy — change only if you run the API on a
# non-standard port (default 8001). The React dev server proxies /api/* to this.
# REACT_APP_API_URL=/api/v1
#
# Warehouse ID displayed in the UI header and used in API calls.
# REACT_APP_WAREHOUSE_ID=DC-47
#
# Set to 'true' to show the Fault Injection panel in the Command Center.
# Requires isDemoMode=true (MAIW_DEMO_MODE=true on backend) AND this flag.
# REACT_APP_FAULT_INJECTION_ENABLED=false

# =============================================================================
# MAIW v2 REFERENCE DEPLOYMENT — Phase 20C-C (Steps 13-17)
# =============================================================================
# Variables required for the qualified single-node reference deployment.
# See docs/operations/REFERENCE_DEPLOYMENT_RUNBOOK.md for full guidance.
#
# REQUIRED = must be set before start_reference_deployment.sh
# OPTIONAL = has a safe default; override to customize
# DEV-ONLY = must NOT be set in reference deployment
# =============================================================================

# --- Inference boundary auth (REQUIRED) --------------------------------------
# Internal token used by NemoClaw/OpenShell sandbox to authenticate against
# POST /api/v1/inference. The sandbox receives this token at launch; the host
# never forwards it to NIM or any other provider.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# Who holds it: MAIW operator (set on host, injected into sandbox at launch)
# Whether sandbox sees it: YES — sandbox uses it to authenticate to MAIW API
# Whether restart required after rotation: YES (API + sandbox must restart)
MAIW_INFERENCE_INTERNAL_TOKEN=your-strong-random-token-min-32-chars

# DEV-ONLY: allow unauthenticated inference (NEVER set in reference deployment)
# MAIW_INFERENCE_ALLOW_UNAUTHENTICATED=false

# --- Operational write credential (REQUIRED for reference_governed) ---------
# v2.0.1 round 3: a SEPARATE credential for governed operational writes
# (POST /api/v1/equipment/assign|release|maintenance and
# /api/v1/executions/...).  Callers send it as the X-Maiw-Operator-Token header.
# The inference token above NEVER authorises a write; a JWT user session alone
# never authorises a write.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# Rules (checked by preflight AND by the app): >= 32 chars, not this
# placeholder, and different from MAIW_INFERENCE_INTERNAL_TOKEN.
# Who holds it: the host operator (CLI / automation / an authenticated operator
# proxy in front of the UI).  Sandbox sees it: NEVER.  Browser bundle: NEVER.
# Unset in profile `reference` (governed writes are not offered there).
# MAIW_OPERATOR_WRITE_TOKEN=your-strong-random-operator-write-token-min-32-chars

# --- Sandbox runtime (REQUIRED for reference deployment) ---------------------
# MAIW_SANDBOX_MODE=required means every agent task runs in an OpenShell sandbox.
# Use "disabled" only for local development without NemoClaw installed.
MAIW_SANDBOX_MODE=required
MAIW_SANDBOX_RUNTIME=openshell
MAIW_NEMOCLAW_VERSION=0.0.124
MAIW_OPENSHELL_VERSION=0.0.116

# Sandbox → host inference endpoint (REQUIRED when sandbox mode=required)
# Since v2.0.1 this is served by the canonical app (maiw_api.app:app) on the
# MAIW API port — there is no separate inference server.
# The sandbox cannot use localhost; it must use the host's routable IP.
# Example: http://10.185.115.61:8001/api/v1/inference
MAIW_SANDBOX_MODEL_GATEWAY_ENDPOINT=http://HOST_IP:8001/api/v1/inference

# Name of the reference sandbox (REQUIRED when MAIW_SANDBOX_MODE=required).
# <= 19 characters.  Created by: bash scripts/setup/reference_sandbox.sh create
# (policy: deploy/openshell/maiw-inference-only.policy.yaml.tmpl).  With
# MAIW_SANDBOX_MODE=required, /api/v1/ready is 503 unless this sandbox is Ready.
MAIW_SANDBOX_NAME=maiw-ref-sandbox
# MAIW_SANDBOX_FROM=base             # OpenShell image / community sandbox name

# Sandbox image (pin exact digest for reproducibility — Step 4)
# MAIW_SANDBOX_IMAGE=nvcr.io/nvidia/nemo/openshell:0.0.116@sha256:<digest>

# --- Persistence (OPTIONAL — defaults to /var/lib/maiw) ---------------------
# Root directory for all durable MAIW state. Read by the API at startup
# (maiw_api.persistence): JsonFileProcedureStateStore → procedures/,
# JsonFileGovernanceInbox → governance/. /api/v1/ready is 503 if unusable.
# Must be writable by the MAIW service user; must NOT be world-writable.
MAIW_PERSISTENCE_ROOT=/var/lib/maiw

# file (default, reference) | memory (DEVELOPMENT/TEST ONLY — state is lost on
# restart; readiness reports durable=false). Never set memory in reference.
# MAIW_PERSISTENCE_MODE=file

# Database readiness: decided by MAIW_DEPLOYMENT_PROFILE (reference /
# reference_governed require it; demo does not).  Explicit override:
# MAIW_READINESS_REQUIRE_DATABASE=true

# Explicit sub-directory overrides (normally derived from MAIW_PERSISTENCE_ROOT)
# MAIW_PROCEDURE_STATE_DIR=/var/lib/maiw/procedures
# MAIW_GOVERNANCE_STATE_DIR=/var/lib/maiw/governance
# MAIW_RUNTIME_STATE_DIR=/var/lib/maiw/runtime

# --- MAIW API server (REQUIRED) ----------------------------------------------
# Lifecycle scripts never assume a default port: they act only on the instance
# recorded in $MAIW_PERSISTENCE_ROOT/runtime/maiw-api.instance.  The port must be
# free (preflight checks).  POST /api/v1/inference is served on this port.
MAIW_API_HOST=0.0.0.0
MAIW_API_PORT=8001

# Python interpreter (venv) that imports maiw_api from THIS checkout (REQUIRED).
# Example: MAIW_PYTHON=/opt/maiw/Multi-Agent-Intelligent-Warehouse/.venv/bin/python
MAIW_PYTHON=/path/to/checkout/.venv/bin/python

# --- Deployment profile (REQUIRED) -------------------------------------------
# reference            durable persistence + ModelGateway + sandbox inference +
#                      DB-backed read routes.  Governed operational writes are
#                      NOT offered (readiness: governed_write_path=not_offered).
# reference_governed   reference + governed operational writes: every required
#                      MCP write domain must be configured, reachable and not
#                      circuit-open, or /api/v1/ready is 503.
# demo                 SimulationProviders (MAIW_DEMO_MODE=true); not a
#                      reference deployment.
MAIW_DEPLOYMENT_PROFILE=reference

# --- MCP servers (REQUIRED for reference_governed; optional otherwise) -------
# Required write domains default to equipment,labor,wave; inventory is
# read-only and optional.  Override the required set with
# MAIW_REQUIRED_MCP_DOMAINS (comma-separated).  Unset = NOT_CONFIGURED.
# MAIW_MCP_SERVER_EQUIPMENT_URL=http://127.0.0.1:<port>/mcp
# MAIW_MCP_SERVER_LABOR_URL=http://127.0.0.1:<port>/mcp
# MAIW_MCP_SERVER_WAVE_URL=http://127.0.0.1:<port>/mcp
# MAIW_MCP_SERVER_INVENTORY_URL=http://127.0.0.1:<port>/mcp
# MAIW_REQUIRED_MCP_DOMAINS=equipment,labor,wave

# DEV-ONLY: enable mock inference (NEVER set in reference deployment)
# MAIW_MOCK_INFERENCE=false

# =============================================================================
# NOTES FOR DEVELOPERS
# =============================================================================
#
# 1. API Key Configuration Summary:
#    - All NIM services use NVIDIA public cloud (https://integrate.api.nvidia.com/v1).
#    - Use a single NVIDIA_API_KEY (nvapi-...) for LLM, embeddings, guardrails, and document NIMs.
#    - EMBEDDING_API_KEY / RAIL_API_KEY default to NVIDIA_API_KEY if unset.
#    - Document Processing & Guardrails: use same NVIDIA_API_KEY or set per-service keys.
#
# 2. Getting API Keys:
#    - NVIDIA API Key: Sign up at https://build.nvidia.com/
#      * Format: nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#      * Used for all NIM endpoints (integrate.api.nvidia.com/v1)
#
# 3. Security:
#    - NEVER commit .env files to version control
#    - Change all default passwords in production
#    - Use strong, unique JWT_SECRET_KEY in production
#    - JWT_SECRET_KEY is REQUIRED in production (app will fail to start without it)
#
# 4. Database:
#    - Default port 5435 is used to avoid conflicts with standard PostgreSQL (5432)
#    - Ensure Docker containers are running before starting the backend
#
# 5. Testing:
#    - View logs in real-time: ./scripts/view_logs.sh
#    - Restart backend: ./restart_backend.sh
#    - Check health: curl http://localhost:8001/api/v1/health
#
# =============================================================================
